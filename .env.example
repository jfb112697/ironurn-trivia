# Base URL the React client fetches datasets from.
#
#   /api                     -> same origin (local dev middleware, or a Worker
#                               routed on the same domain via Pages)
#   https://<worker>.workers.dev/api
#
# Set this at build time; GitHub Actions passes it from the `API_BASE` repo
# variable (Settings → Secrets and variables → Actions → Variables).
VITE_DATA_BASE=/api
