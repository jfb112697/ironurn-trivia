# Base URL the React client fetches datasets from.
#
#   /data          -> the default: dataset files baked into the deploy and
#                     served as static assets (free, unlimited, no Worker quota)
#   https://<worker>.workers.dev/api
#                  -> the same files served by the edge Worker out of R2, for
#                     API consumers or a self-hosted client
#
# Set this at build time. Only needed if you want the client to read from the
# API instead of its own static copy.
VITE_DATA_BASE=/data
